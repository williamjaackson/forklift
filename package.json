{
  "name": "forklift-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "bundle": "pnpm build && esbuild packages/cli/dist/bin.js --bundle --platform=node --target=node20 --format=cjs --log-level=warning --outfile=dist/forklift.cjs",
    "forklift": "node dist/forklift.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@12.21.0"
}
