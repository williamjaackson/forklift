# Forks to keep in sync, separated by spaces.
FORKLIFT_REPOS=your-name/your-fork

# How often the builder looks upstream.
FORKLIFT_EVERY=3h

# --- build container: can read, cannot push -------------------------------

# Only for private forks: a fine-grained token with read-only Contents.
FORKLIFT_READ_TOKEN=

# For `agent: claude`: a subscription token from `claude setup-token`…
CLAUDE_CODE_OAUTH_TOKEN=
# …or an API key.
ANTHROPIC_API_KEY=

# --- publish container: can push, runs no code ----------------------------

# A GitHub App installed on the forks, so pull requests and commits come from
# its bot account (see "Acting as a bot" in the README). The key is the .pem
# file's contents on one line, with \n where the line breaks were.
FORKLIFT_APP_ID=
FORKLIFT_APP_PRIVATE_KEY=

# Or, instead of an App: a fine-grained token limited to the forks, with
# read/write on Contents, Pull requests and Issues. Pull requests
# then come from the token's owner.
FORKLIFT_WRITE_TOKEN=
